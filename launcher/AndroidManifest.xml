<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="fast.home">
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- Lets only the Home-button helper (same signing key) receive this app's cover messages. -->
  <permission android:name="fast.home.COVER" android:protectionLevel="signature"/>
  <uses-permission android:name="fast.home.COVER"/>
  <uses-feature android:name="android.software.leanback" android:required="false"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <queries>
    <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
    <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
    <package android:name="fast.home.redirect"/>
  </queries>
  <application android:label="Fast Home" android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:hardwareAccelerated="true">
    <activity android:name=".Home" android:exported="true" android:launchMode="singleTask" android:label="Fast Home">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.HOME"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </activity>
    <activity android:name=".InputActivity" android:exported="false" android:launchMode="singleTop"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"/>
  </application>
</manifest>
