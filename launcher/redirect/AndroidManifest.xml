<?xml version="1.0" encoding="utf-8"?>
<!-- Optional helper: makes the Home button open Fast Home. Off until enabled in Settings > Accessibility. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="fast.home.redirect">
  <uses-permission android:name="android.permission.READ_LOGS"/>
  <uses-permission android:name="fast.home.COVER"/> <!-- defined by Fast Home: install it first -->
  <queries><package android:name="fast.home"/></queries>
  <application android:label="Fast Home: Home button">
    <service android:name="fast.home.HomeRedirect" android:exported="true" android:label="Fast Home: Home button"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_redirect"/>
    </service>
  </application>
</manifest>
